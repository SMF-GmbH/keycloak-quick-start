# .env.example – nach .env kopieren und anpassen:
#   cp .env.example .env
#
# Bitte ändere alle Werte und nutze für Secrets z. B. "SOPS: Secrets OPerationS".
# Die echte .env-Datei gehört NICHT in die Versionskontrolle (siehe .gitignore).

# Feste Image-Versionen verwenden – kein "latest"!
TAG_KC=26.7.0
TAG_DB=18.4

# Datenbank-Zugangsdaten
DB_USER=keycloak
DB_PW=helloKeycloak

# Temporärer Keycloak-Admin für die Ersteinrichtung
KC_ADMIN=admin
KC_ADMIN_PW=helloKeycloak
